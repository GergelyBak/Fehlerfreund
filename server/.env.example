# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fehlerfreund?retryWrites=true&w=majority
# mock = free canned AI responses for development, live = real Claude calls (costs money)
LLM_MODE=mock
# Anthropic API key - server side only, never expose to the client. Required only when LLM_MODE=live
ANTHROPIC_API_KEY=sk-ant-...
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Daily token budget per user (input + output tokens)
DAILY_TOKEN_BUDGET=200000
