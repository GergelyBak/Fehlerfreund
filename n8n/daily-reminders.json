{
  "name": "Fehlerfreund – daily reminders",
  "nodes": [
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000007",
      "name": "Run now (test)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "apiUrl",
              "value": "http://localhost:4000",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "fromEmail",
              "value": "Fehlerfreund <you@example.com>",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "ignoreTime",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000003",
      "name": "Get due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ $json.apiUrl }}/api/internal/reminders{{ $json.ignoreTime ? '?ignoreTime=1' : '' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "fehlerfreundApiKey",
          "name": "Fehlerfreund API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000004",
      "name": "One item per email",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      }
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000005",
      "name": "Send email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.text }}",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "fehlerfreundSmtp",
          "name": "Fehlerfreund SMTP"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "2b0c6d8e-1f4a-4c4e-9d0a-000000000006",
      "name": "Mark as sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiUrl }}/api/internal/reminders/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ userIds: [$('One item per email').item.json.userId] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "fehlerfreundApiKey",
          "name": "Fehlerfreund API key"
        }
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (test)": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Get due reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get due reminders": {
      "main": [
        [
          {
            "node": "One item per email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per email": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Mark as sent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
